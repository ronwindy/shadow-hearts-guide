---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getTocData } from '../lib/guideData';

const tocData = getTocData();
const overview = tocData.guide.overview;
---

<BaseLayout
  title="Table of Contents — Shadow Hearts Strategy Guide"
  description="Complete index of all 69 sections of the Shadow Hearts Walkthrough and FAQ, including Asia, Europe, Side Quests, and Appendices."
>
  <div class="space-y-8">
    <!-- Header -->
    <div class="border-b border-slate-800 pb-6">
      <h1 class="page-title gold-metal-text text-3xl sm:text-4xl font-serif font-semibold">
        Table of Contents
      </h1>
      <div class="page-title-rule" aria-hidden="true"><span></span></div>
      <p class="mt-4text-slate-400 max-w-3xl text-sm sm:text-base">
        Browse the complete walkthrough and reference sections for Shadow Hearts. Use the search filter below to quickly find any town, dungeon, boss, side quest, or appendix.
      </p>
    </div>

    <!-- Table of Contents Component -->
    <TableOfContents sections={overview.sections} />
  </div>
</BaseLayout>
