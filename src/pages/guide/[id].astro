---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageToc from '../../components/PageToc.astro';
import StepChecklist from '../../components/StepChecklist.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ManualOverview from '../../components/ManualOverview.astro';
import CharacterProfiles from '../../components/CharacterProfiles.astro';
import ItemTable from '../../components/ItemTable.astro';
import EnemyTable from '../../components/EnemyTable.astro';
import ShopTable from '../../components/ShopTable.astro';
import ReferenceBlocks from '../../components/ReferenceBlocks.astro';
import Callouts from '../../components/Callouts.astro';
import ObjectivesList from '../../components/ObjectivesList.astro';
import RouteProgression from '../../components/RouteProgression.astro';
import SavePoints from '../../components/SavePoints.astro';
import InitialSetup from '../../components/InitialSetup.astro';
import DocumentInfo from '../../components/DocumentInfo.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import {
  getAllStructuredSections,
  buildPageTocSections
} from '../../lib/guideData';
import type { GuideContent } from '../../lib/types';
import { ChevronLeft, ChevronRight, ArrowLeft, ArrowRight, ListChecks } from '@lucide/astro';

export async function getStaticPaths() {
  const sections = getAllStructuredSections();
  return sections.map((sec) => ({
    params: { id: sec.id },
    props: { section: sec.data },
  }));
}

const { section } = Astro.props;
const guide: GuideContent = section.guide || {};
const overview = guide.overview || {};
const navigation = guide.navigation || {};
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideHref = (id: string) => `${baseUrl}/guide/${id}`;

// Normalizations across walkthrough and reference schemas
const objectives = guide.objectives || (overview.objective ? [overview.objective] : []);
const route = guide.route || overview.route || [];
const steps = guide.steps || [];
const enemies = guide.enemies || [];
const bosses = guide.bosses || (guide.boss ? [guide.boss] : []);
const shops = guide.shops || [];

// Compute local on-page sections for Right TOC and Mobile Drawer
const pageSections = buildPageTocSections(guide);
---

<BaseLayout
  title={`${guide.title || 'Guide Section'} — Shadow Hearts Strategy Guide`}
  description={`Shadow Hearts Strategy Guide & Walkthrough — ${guide.title || 'Guide Section'}`}
  currentId={guide.id || ''}
  pageSections={pageSections}
  isWide={true}
>
  <!-- Guide Page Layout: Center Content + Right Local TOC -->
  <div class="flex gap-6 lg:gap-8 items-start relative">
    <!-- Center Column: Main Content -->
    <article class="flex-1 min-w-0 max-w-4xl mx-auto space-y-8">
      <!-- Breadcrumb & Top Prev/Next -->
      <div class="flex items-center justify-between text-sm text-slate-400 border-b border-slate-800/80 pb-4">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 min-w-0">
          <a href={`${baseUrl}/toc`} class="hover:text-gold-400 transition-colors flex-shrink-0">Chapters</a>
          <span aria-hidden="true">/</span>
          <span class="text-slate-400 truncate max-w-[120px] sm:max-w-xs">{guide.category}</span>
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="text-gold-400 font-medium truncate max-w-[150px] sm:max-w-md">{guide.title}</span>
        </nav>

        <nav aria-label="Previous and next chapter" class="flex items-center gap-3 flex-shrink-0 ml-2">
          {navigation.prev && (
            <a href={guideHref(navigation.prev.id)} aria-label={`Previous chapter: ${navigation.prev.title}`} class="hover:text-gold-400 text-slate-300 transition-colors flex items-center gap-1">
              <ChevronLeft class="w-3.5 h-3.5" aria-hidden="true" />
              <span class="hidden sm:inline">Prev</span>
            </a>
          )}
          {navigation.next && (
            <a href={guideHref(navigation.next.id)} aria-label={`Next chapter: ${navigation.next.title}`} class="hover:text-gold-400 text-slate-300 transition-colors flex items-center gap-1">
              <span class="hidden sm:inline">Next</span>
              <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
            </a>
          )}
        </nav>
      </div>

      <header>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-extrabold text-slate-100">
          {guide.title}
        </h1>
      </header>

      <div class="space-y-8">
        <Callouts callouts={guide.callouts} />

        {/* Table of Contents Section (e.g. I-1-00) */}
        {overview.sections && overview.sections.length > 0 && (
          <section id="toc-index" class="space-y-4">
            <TableOfContents sections={overview.sections} />
          </section>
        )}

        <ManualOverview overview={overview} />
        <CharacterProfiles characters={overview.characters} glossary={overview.glossary} />

        <ObjectivesList objectives={objectives} />
        <RouteProgression route={route} />
        <SavePoints savePoints={guide.save_points} />
        <InitialSetup setup={guide.initial_setup} />

        {/* Walkthrough steps come before reference tables so the checklist is reachable while playing */}
        {steps.length > 0 && (
          <section id="steps" class="space-y-4">
            <SectionHeading icon={ListChecks}>
              Walkthrough Steps
              <span slot="aside" class="text-sm font-mono text-slate-400">{steps.length} steps &bull; Tap to track</span>
            </SectionHeading>
            <StepChecklist guideId={guide.id || guide.code || ""} steps={steps} bosses={bosses} />
          </section>
        )}

        <ItemTable items={guide.items_summary?.obtainable} />
        <EnemyTable enemies={enemies} />
        <ShopTable shops={shops} />

        {/* Verbatim reference/appendix tables */}
        <ReferenceBlocks blocks={guide.reference_blocks || []} />

        <DocumentInfo metadata={overview.metadata} purpose={overview.purpose} guideScope={overview.guide_scope} />
      </div>

      <!-- Prev / Next Navigation Footer (Responsive Grid) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 border-t border-slate-800/80 pt-6 mt-12">
        {navigation.prev ? (
          <a
            href={guideHref(navigation.prev.id)}
            class="card p-4 hover:border-gold-500/50 flex items-center gap-3 group transition-all"
          >
            <ArrowLeft class="w-5 h-5 text-gold-500 group-hover:-translate-x-1 motion-reduce:transform-none transition-transform flex-shrink-0" aria-hidden="true" />
            <div class="min-w-0 flex-1">
              <div class="text-xs font-mono text-slate-400 uppercase">Previous Chapter</div>
              <div class="text-sm sm:text-base font-medium text-slate-200 group-hover:text-gold-300 truncate">
                {navigation.prev.title}
              </div>
            </div>
          </a>
        ) : <div class="hidden sm:block"></div>}

        {navigation.next && (
          <a
            href={guideHref(navigation.next.id)}
            class="card p-4 hover:border-gold-500/50 flex items-center justify-between gap-3 text-right group transition-all sm:col-start-2"
          >
            <div class="min-w-0 flex-1">
              <div class="text-xs font-mono text-slate-400 uppercase">Next Chapter</div>
              <div class="text-sm sm:text-base font-medium text-slate-200 group-hover:text-gold-300 truncate">
                {navigation.next.title}
              </div>
            </div>
            <ArrowRight class="w-5 h-5 text-gold-500 group-hover:translate-x-1 motion-reduce:transform-none transition-transform flex-shrink-0" aria-hidden="true" />
          </a>
        )}
      </div>
    </article>

    <!-- Right Sidebar: On-This-Page Local TOC (Desktop >= xl) -->
    {pageSections.length > 0 && (
      <aside class="hidden xl:block w-56 2xl:w-64 flex-shrink-0 sticky top-6 max-h-[calc(100vh-3rem)] rounded-xl border border-slate-800/80 bg-obsidian/80 backdrop-blur shadow-sm overflow-y-auto custom-scrollbar">
        <PageToc sections={pageSections} />
      </aside>
    )}
  </div>
</BaseLayout>
