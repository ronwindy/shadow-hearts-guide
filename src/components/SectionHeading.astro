---
interface Props {
  icon: any;
  iconClass?: string;
}

const { icon: Icon, iconClass = 'text-gold-400' } = Astro.props;
---

<div class="heading-flourish flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
  <h2 class="text-xl sm:text-2xl font-serif font-bold text-slate-100 flex items-center gap-2.5">
    <Icon class:list={['w-5 h-5 flex-shrink-0', iconClass]} aria-hidden="true" />
    <span><slot /></span>
  </h2>
  <slot name="aside" />
</div>
