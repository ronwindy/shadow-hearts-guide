---
interface Props {
  sourceUrl?: string;
  author?: string;
  version?: string;
}

const {
  sourceUrl = "https://gamefaqs.gamespot.com/ps2/459510-shadow-hearts/faqs/80397",
  author = "A_Backdated_Future",
  version = "1.05"
} = Astro.props;
---

<footer class="mt-20 border-t border-slate-800 bg-[#0c0e14] py-12 text-sm text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="space-y-1 text-center md:text-left">
      <p class="text-slate-200 font-medium text-base">
        Shadow Hearts Strategy Guide & Walkthrough
      </p>
      <p class="text-sm text-slate-400">
        Based on the canonical guide by <span class="text-slate-200 font-semibold">{author}</span> (Version {version}, 02/15/2012).
      </p>
    </div>

    <div class="flex items-center space-x-6 text-sm text-slate-400">
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 underline decoration-slate-700 underline-offset-4 transition-colors">
        View GameFAQs Canonical Source
      </a>
      <span class="text-slate-700">|</span>
      <span>Static Site &bull; Astro</span>
    </div>
  </div>
</footer>
