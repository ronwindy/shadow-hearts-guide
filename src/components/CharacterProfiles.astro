---
import { Users, User, BookOpen, Sparkles } from '@lucide/astro';
import CollapsibleSection from './CollapsibleSection.astro';
import BadgeCard from './BadgeCard.astro';
import { renderInlineMarkup } from '../lib/markup';
import { getElementMeta, getGlossaryMeta } from '../lib/manualMeta';
import type { CharacterProfile, GlossaryTerm } from '../lib/types';

interface Props {
  characters?: CharacterProfile[];
  glossary?: GlossaryTerm[];
}

const { characters = [], glossary = [] } = Astro.props;
---

<div class="space-y-8">
  {characters.length > 0 && (
    <CollapsibleSection id="characters" title="Character Profiles" icon={Users}>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {characters.map((char) => {
          const elementMeta = char.class ? getElementMeta(char.class) : null;
          const ElementIcon = elementMeta?.icon ?? Sparkles;
          return (
            <div class="p-4 rounded-xl bg-slate-850/90 border border-slate-800 space-y-2.5 text-sm sm:text-base shadow-sm">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h3 class="text-lg sm:text-xl font-serif font-semibold text-slate-100 flex items-center gap-2">
                  <span class="w-7 h-7 rounded-lg bg-amber-950/40 border border-amber-800/50 flex items-center justify-center flex-shrink-0">
                    <User class="w-4 h-4 text-amber-300" aria-hidden="true" />
                  </span>
                  <span>{char.name}</span>
                </h3>
                <div class="flex items-center gap-2">
                  {char.class && elementMeta && (
                    <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md border font-mono text-xs font-semibold ${elementMeta.badgeClass}`}>
                      <ElementIcon class="w-3 h-3" aria-hidden="true" />
                      <span>{char.class}</span>
                    </span>
                  )}
                  {char.age && (
                    <span class="text-slate-400 font-mono text-xs px-2 py-0.5 rounded bg-slate-900/60 border border-slate-800">
                      Age: {char.age}
                    </span>
                  )}
                </div>
              </div>
              <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
                <Fragment set:html={renderInlineMarkup(char.profile)} />
              </p>
            </div>
          );
        })}
      </div>
    </CollapsibleSection>
  )}

  {glossary.length > 0 && (
    <CollapsibleSection id="glossary" title="Lore & Terminology" icon={BookOpen}>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {glossary.map((g) => {
          const meta = getGlossaryMeta(g.term);
          return (
            <BadgeCard icon={meta.icon} label={g.term} badgeClass={meta.badgeClass} labelClass="text-sm font-serif font-semibold">
              <Fragment set:html={renderInlineMarkup(g.description)} />
            </BadgeCard>
          );
        })}
      </div>
    </CollapsibleSection>
  )}
</div>
