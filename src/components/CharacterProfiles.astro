---
import { Users, User, BookOpen } from '@lucide/astro';
import type { CharacterProfile, GlossaryTerm } from '../lib/types';

interface Props {
  characters?: CharacterProfile[];
  glossary?: GlossaryTerm[];
}

const { characters = [], glossary = [] } = Astro.props;
---

<div class="space-y-8">
  {/* Character Profiles */}
  {characters && characters.length > 0 && (
    <section id="characters" class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-serif font-bold text-slate-100 border-b border-slate-800 pb-2 flex items-center gap-2.5">
        <Users class="w-5 h-5 text-gold-400" />
        <span>Character Profiles</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {characters.map((char) => (
          <div class="p-4 rounded-xl bg-slate-850/90 border border-slate-800 space-y-2 text-sm sm:text-base">
            <div class="flex items-center justify-between">
              <h3 class="text-lg sm:text-xl font-serif font-bold text-slate-100 flex items-center gap-1.5">
                <User class="w-4 h-4 text-amber-300" />
                <span>{char.name}</span>
              </h3>
              <div class="flex items-center gap-2">
                {char.class && (
                  <span class="px-2 py-0.5 rounded bg-amber-950/40 text-amber-300 border border-amber-800/40 font-mono text-xs">
                    {char.class}
                  </span>
                )}
                {char.age && <span class="text-slate-400 text-xs">Age: {char.age}</span>}
              </div>
            </div>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">{char.profile}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* Lore & Terminology Glossary */}
  {glossary && glossary.length > 0 && (
    <section id="glossary" class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-serif font-bold text-slate-100 border-b border-slate-800 pb-2 flex items-center gap-2.5">
        <BookOpen class="w-5 h-5 text-gold-400" />
        <span>Lore & Terminology</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {glossary.map((g) => (
          <div class="p-4 rounded-xl bg-slate-850/90 border border-slate-800 space-y-1 text-sm sm:text-base">
            <h3 class="font-serif font-bold text-gold-400 text-base sm:text-lg">{g.term}</h3>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">{g.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}
</div>
