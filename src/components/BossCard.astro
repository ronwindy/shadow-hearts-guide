---
import {
  Skull,
  Swords,
  Coins,
  Sparkles,
  User,
  Heart,
  Package,
  Zap
} from '@lucide/astro';

interface BossEnemy {
  name: string;
  hp?: number | string;
  class?: string;
  drop?: string;
}

interface BossPartyMember {
  name: string;
  level?: number | string;
}

interface BossData {
  type?: string;
  name: string;
  exp?: number | string;
  cash?: number | string;
  enemies?: BossEnemy[];
  party?: BossPartyMember[];
  strategy?: string;
}

interface Props {
  boss: BossData;
}

const { boss } = Astro.props;
const isSubBoss = boss.type?.toUpperCase().includes('SUB-BOSS');
---

<div class={`boss-card relative rounded-xl border p-5 sm:p-6 space-y-4 shadow-gothic-card overflow-hidden ${
  isSubBoss
    ? 'border-amber-900/50 bg-gradient-to-b from-amber-950/20 via-slate-900/90 to-obsidian'
    : 'border-rose-900/50 bg-gradient-to-b from-rose-950/20 via-slate-900/90 to-obsidian'
}`}>
  <!-- Thematic ambient glow -->
  <div class={`absolute -top-12 -right-12 w-48 h-48 rounded-full blur-2xl pointer-events-none ${
    isSubBoss ? 'bg-amber-600/10' : 'bg-rose-600/10'
  }`}></div>

  <!-- Header -->
  <div class={`relative z-10 flex flex-wrap items-baseline justify-between gap-3 border-b pb-3 ${
    isSubBoss ? 'border-amber-900/40' : 'border-rose-900/40'
  }`}>
    <div class="flex items-center gap-2.5">
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono font-bold uppercase tracking-wider border ${
        isSubBoss
          ? 'bg-amber-950 text-amber-300 border-amber-800'
          : 'bg-rose-950 text-rose-300 border-rose-800'
      }`}>
        {isSubBoss ? <Swords class="w-3.5 h-3.5" /> : <Skull class="w-3.5 h-3.5" />}
        <span>{boss.type || 'BOSS ENCOUNTER'}</span>
      </span>
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-slate-100 tracking-wide">
        {boss.name}
      </h3>
    </div>

    <!-- Spoils of War -->
    <div class="flex items-center gap-2 text-sm font-mono">
      {boss.exp && (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-900/90 border border-slate-800 text-amber-300">
          <Sparkles class="w-3 h-3 text-amber-400" />
          <span>EXP: {boss.exp}</span>
        </span>
      )}
      {boss.cash && (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-900/90 border border-slate-800 text-gold-400">
          <Coins class="w-3 h-3 text-gold-400" />
          <span>Cash: {boss.cash}</span>
        </span>
      )}
    </div>
  </div>

  <!-- Recommended Party -->
  {boss.party && boss.party.length > 0 && (
    <div class="relative z-10 flex flex-wrap items-center gap-2 text-sm">
      <span class="font-mono text-slate-400 text-xs font-semibold flex items-center gap-1">
        <User class="w-3.5 h-3.5 text-slate-400" />
        <span>Recommended Party:</span>
      </span>
      {boss.party.map((p) => (
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded bg-slate-900 border border-slate-700/80 font-mono text-slate-200 text-xs">
          <User class="w-3 h-3 text-gold-400/80" />
          <span>{p.name} {p.level ? `[Lv ${p.level}]` : ''}</span>
        </span>
      ))}
    </div>
  )}

  <!-- Enemy Units Block -->
  {boss.enemies && boss.enemies.length > 0 && (
    <div class="relative z-10 grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm">
      {boss.enemies.map((be) => (
        <div class="p-3.5 rounded-lg bg-slate-900/80 border border-slate-800/80 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-slate-200 font-serif flex items-center gap-1.5 text-sm sm:text-base">
              <Skull class="w-3.5 h-3.5 text-rose-400" />
              <span>{be.name}</span>
            </span>
            {be.class && (
              <span class="px-2 py-0.5 rounded text-xs font-mono bg-amber-950/40 text-amber-300 border border-amber-800/40">
                Class: {be.class}
              </span>
            )}
          </div>
          <div class="flex items-center justify-between text-slate-400 font-mono text-xs">
            <span class="inline-flex items-center gap-1">
              <Heart class="w-3.5 h-3.5 text-rose-400" />
              <span>HP: <strong class="text-rose-400 font-bold">{be.hp ?? 'Unknown'}</strong></span>
            </span>
            {be.drop && (
              <span class="inline-flex items-center gap-1">
                <Package class="w-3.5 h-3.5 text-emerald-400" />
                <span>Drop: <strong class="text-emerald-400 font-bold">{be.drop}</strong></span>
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- Strategy Section -->
  {boss.strategy && (
    <div class="relative z-10 p-4 sm:p-5 rounded-lg bg-slate-950/70 border border-slate-800/90 space-y-2.5">
      <div class="flex items-center gap-1.5 text-sm font-mono font-bold uppercase tracking-wider text-gold-400">
        <Zap class="w-4 h-4 text-gold-400" />
        <span>Tactical Strategy & Advice</span>
      </div>
      <p class="text-base text-slate-200 leading-relaxed whitespace-pre-line">
        {boss.strategy}
      </p>
    </div>
  )}
</div>
