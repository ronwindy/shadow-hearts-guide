---
interface BossEnemy {
  name: string;
  hp?: number | string;
  class?: string;
  drop?: string;
}

interface BossPartyMember {
  name: string;
  level?: number | string;
}

interface BossData {
  type?: string;
  name: string;
  exp?: number | string;
  cash?: number | string;
  enemies?: BossEnemy[];
  party?: BossPartyMember[];
  strategy?: string;
}

interface Props {
  boss: BossData;
}

const { boss } = Astro.props;
const isSubBoss = boss.type?.toUpperCase().includes('SUB-BOSS');
---

<div class={`boss-card relative rounded-xl border p-5 sm:p-6 space-y-4 shadow-gothic-card overflow-hidden ${
  isSubBoss
    ? 'border-amber-900/50 bg-gradient-to-b from-amber-950/20 via-slate-900/90 to-obsidian'
    : 'border-rose-900/50 bg-gradient-to-b from-rose-950/20 via-slate-900/90 to-obsidian'
}`}>
  <!-- Thematic ambient glow -->
  <div class={`absolute -top-12 -right-12 w-48 h-48 rounded-full blur-2xl pointer-events-none ${
    isSubBoss ? 'bg-amber-600/10' : 'bg-rose-600/10'
  }`}></div>

  <!-- Header -->
  <div class={`relative z-10 flex flex-wrap items-baseline justify-between gap-3 border-b pb-3 ${
    isSubBoss ? 'border-amber-900/40' : 'border-rose-900/40'
  }`}>
    <div class="flex items-center gap-2.5">
      <span class={`px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider border ${
        isSubBoss
          ? 'bg-amber-950 text-amber-300 border-amber-800'
          : 'bg-rose-950 text-rose-300 border-rose-800'
      }`}>
        {boss.type || 'BOSS ENCOUNTER'}
      </span>
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-slate-100 tracking-wide">
        {boss.name}
      </h3>
    </div>

    <!-- Spoils of War -->
    <div class="flex items-center gap-2 text-xs font-mono">
      {boss.exp && (
        <span class="px-2.5 py-1 rounded bg-slate-900/90 border border-slate-800 text-amber-300">
          EXP: {boss.exp}
        </span>
      )}
      {boss.cash && (
        <span class="px-2.5 py-1 rounded bg-slate-900/90 border border-slate-800 text-gold-400">
          Cash: {boss.cash}
        </span>
      )}
    </div>
  </div>

  <!-- Recommended Party -->
  {boss.party && boss.party.length > 0 && (
    <div class="relative z-10 flex flex-wrap items-center gap-2 text-xs">
      <span class="font-mono text-slate-400 text-[11px] font-semibold">Recommended Party:</span>
      {boss.party.map((p) => (
        <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700/80 font-mono text-slate-200 text-xs">
          🛡️ {p.name} {p.level ? `[Lv ${p.level}]` : ''}
        </span>
      ))}
    </div>
  )}

  <!-- Enemy Units Block -->
  {boss.enemies && boss.enemies.length > 0 && (
    <div class="relative z-10 grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
      {boss.enemies.map((be) => (
        <div class="p-3 rounded-lg bg-slate-900/80 border border-slate-800/80 space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-slate-200 font-serif">{be.name}</span>
            {be.class && (
              <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-amber-950/40 text-amber-300 border border-amber-800/40">
                Class: {be.class}
              </span>
            )}
          </div>
          <div class="flex items-center justify-between text-slate-400 font-mono text-[11px]">
            <span>HP: <strong class="text-rose-400">{be.hp ?? 'Unknown'}</strong></span>
            {be.drop && <span>Drop: <strong class="text-emerald-400">{be.drop}</strong></span>}
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- Strategy Section -->
  {boss.strategy && (
    <div class="relative z-10 p-4 rounded-lg bg-slate-950/70 border border-slate-800/90 space-y-2">
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-gold-400">
        <svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Tactical Strategy & Advice</span>
      </div>
      <p class="text-sm text-slate-200 leading-relaxed whitespace-pre-line">
        {boss.strategy}
      </p>
    </div>
  )}
</div>
