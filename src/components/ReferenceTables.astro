---
import { Table2 } from '@lucide/astro';
import { getItemIcon, getWeaponIcon, getValuableIcon } from '../lib/itemIcons';

interface TableRow {
  cells: string[];
  description?: { menu?: string; title?: string; text?: string };
  children?: { columns: string[]; rows: TableRow[] }[];
}
interface RefTable {
  title?: string;
  intro?: string;
  columns: string[];
  rows: TableRow[];
}

interface Props {
  tables?: RefTable[];
  /** Which per-name icon map to use for first-column names. */
  iconSet?: 'valuables';
}

const { tables = [], iconSet } = Astro.props;
---

{tables.length > 0 && (
  <section id="reference" class="space-y-4">
    <div class="flex items-center justify-between heading-flourish">
      <h2 class="text-xl sm:text-2xl font-serif font-semibold text-slate-100 flex items-center gap-2.5">
        <Table2 class="w-5 h-5 text-gold-400 flex-shrink-0" />
        <span class="gold-metal-lite">Reference Tables</span>
      </h2>
      <span class="text-sm font-mono text-slate-400">{tables.reduce((n, t) => n + t.rows.length, 0)} entries</span>
    </div>
    {tables.map((t) => (
      <div class="space-y-3">
        {t.title && (
          <h3 class="text-lg font-serif font-semibold text-gold-400 flex items-center gap-2">
            {(() => { const ic = getWeaponIcon(t.title); return ic ? <ic.icon class={`w-5 h-5 flex-shrink-0 ${ic.color}`} aria-hidden="true" /> : null; })()}
            {t.title}
          </h3>
        )}
        {t.intro && <p class="text-slate-300 leading-relaxed">{t.intro}</p>}
        <div class="rounded-xl border border-slate-800 bg-slate-850/90 shadow-sm sm:overflow-x-auto">
          <table class="w-full text-sm sm:text-base text-left max-sm:block">
            <thead class="max-sm:hidden">
              <tr class="border-b border-slate-800 text-slate-400 font-sans bg-slate-900/80">
                {t.columns.map((c) => <th class="py-3 px-4 font-semibold">{c}</th>)}
              </tr>
            </thead>
            {t.rows.map((r) => (
              <tbody class="border-b border-slate-800/60 last:border-b-0 text-slate-300 hover:bg-slate-800/30 transition-colors max-sm:block max-sm:px-3 max-sm:py-3">
                <tr class="max-sm:flex max-sm:flex-wrap max-sm:gap-x-3 max-sm:gap-y-1">
                  {r.cells.map((cell, i) => (
                    <td
                      class={
                        i === 0
                          ? 'py-2.5 px-4 font-semibold text-emerald-400 sm:whitespace-nowrap max-sm:w-full max-sm:p-0'
                          : 'py-2.5 px-4 text-slate-200 max-sm:p-0'
                      }
                    >
                      {i === 0 && (() => { const ic = (iconSet === 'valuables' ? getValuableIcon(cell) : undefined) ?? getItemIcon(cell) ?? (t.title ? getWeaponIcon(t.title) : undefined); return ic ? <ic.icon class={`inline-block w-4 h-4 mr-1.5 -mt-0.5 flex-shrink-0 ${ic.color}`} aria-hidden="true" /> : null; })()}
                      {i > 0 && <span class="sm:hidden text-xs uppercase tracking-wide text-slate-500 mr-1">{t.columns[i]}:</span>}
                      {cell}
                    </td>
                  ))}
                </tr>
                {r.description && (r.description.menu || r.description.title || r.description.text) && (
                  <tr class="max-sm:block">
                    <td colspan={t.columns.length} class="px-4 pb-3 pt-0 text-sm text-slate-400 leading-relaxed max-sm:block max-sm:p-0 max-sm:mt-1">
                      {r.description.menu && <p><span class="text-xs uppercase tracking-wide text-slate-500 mr-1.5">Menu</span>{r.description.menu}</p>}
                      {(r.description.text || r.description.title) && (
                        <p class={r.description.menu ? 'mt-1' : ''}>
                          {r.description.menu && <span class="text-xs uppercase tracking-wide text-slate-500 mr-1.5">Info</span>}
                          {r.description.title && <span class="font-semibold text-slate-300 mr-1.5">{r.description.title}</span>}
                          {r.description.text}
                        </p>
                      )}
                    </td>
                  </tr>
                )}
                {(r.children ?? []).map((ch) => (
                  <tr class="max-sm:block">
                    <td colspan={t.columns.length} class="px-4 pb-3 pt-0 max-sm:block max-sm:p-0 max-sm:mt-1">
                      <div class="rounded-lg border border-slate-800/80 bg-slate-900/50 overflow-x-auto">
                        <table class="w-full text-sm text-left">
                          <thead>
                            <tr class="border-b border-slate-800 text-slate-400 font-sans bg-slate-900/80">
                              {ch.columns.map((c) => <th class="py-2 px-3 font-semibold">{c}</th>)}
                            </tr>
                          </thead>
                          <tbody>
                            {ch.rows.map((cr) => (
                              <tr class="border-b border-slate-800/60 last:border-b-0 text-slate-200">
                                {cr.cells.map((cell) => <td class="py-2 px-3">{cell}</td>)}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </div>
    ))}
  </section>
)}
