---
import { Menu, Flame, House, BookOpen, ExternalLink } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="lg:hidden sticky top-0 z-40 bg-obsidian/95 backdrop-blur-md border-b border-slate-800 shadow-sm">
  <div class="px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between">
    <!-- Left: Hamburger Drawer Trigger -->
    <button
      id="open-mobile-drawer"
      class="p-2 -ml-2 rounded-lg text-slate-300 hover:text-gold-400 hover:bg-slate-800/80 transition-colors focus:outline-none focus:ring-1 focus:ring-gold-500"
      aria-label="Open chapters and navigation menu"
    >
      <Menu class="w-6 h-6" />
    </button>

    <!-- Right: Brand Logo -->
    <a href={`${baseUrl}/`} class="flex items-center group py-1">
      <img
        src={`${baseUrl}/logo.png`}
        alt="Shadow Hearts Strategy Guide"
        class="h-7 sm:h-8 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
      />
    </a>
  </div>
</header>
