---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 bg-obsidian/95 backdrop-blur-md border-b border-slate-800 shadow-sm">
  <div class="max-w-[1600px] mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Left brand & mobile hamburger -->
    <div class="flex items-center space-x-3">
      <!-- Mobile Drawer Trigger Button -->
      <button
        id="open-mobile-drawer"
        class="lg:hidden p-2 rounded-lg text-slate-300 hover:text-gold-400 hover:bg-slate-800/80 transition-colors focus:outline-none focus:ring-1 focus:ring-gold-500"
        aria-label="Open chapters and outline drawer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <a href={`${baseUrl}/`} class="flex items-center space-x-2.5 text-slate-100 hover:text-gold-400 transition-colors">
        <span class="w-2.5 h-2.5 rounded-full bg-gold-500 shadow-gold-glow"></span>
        <span class="text-xl font-serif font-bold tracking-wider text-gold-400">SHADOW HEARTS</span>
        <span class="hidden sm:inline-block text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-amber-950/40 text-amber-300 border border-amber-800/50">
          Gothic Strategy Guide
        </span>
      </a>
    </div>

    <!-- Center/Right navigation links -->
    <nav class="flex items-center space-x-1 sm:space-x-3 text-sm font-medium">
      <a href={`${baseUrl}/`} class="px-3 py-1.5 rounded-md text-slate-300 hover:text-gold-300 hover:bg-slate-850 transition-colors">
        Home
      </a>
      <a href={`${baseUrl}/toc`} class="px-3 py-1.5 rounded-md text-slate-300 hover:text-gold-300 hover:bg-slate-850 transition-colors">
        Chapters
      </a>
      <a href="https://gamefaqs.gamespot.com/ps2/459510-shadow-hearts/faqs/80397" target="_blank" rel="noopener noreferrer" class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-md text-slate-400 hover:text-gold-400 transition-colors">
        <span>Original FAQ</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>
