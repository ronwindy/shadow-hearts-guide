---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-50 bg-[#0c0e14]/90 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <a href={`${baseUrl}/`} class="flex items-center space-x-2 text-slate-100 hover:text-gold-400 transition-colors">
        <span class="text-xl font-serif font-bold tracking-wider text-gold-500">SHADOW HEARTS</span>
        <span class="hidden sm:inline-block text-xs uppercase px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Guide</span>
      </a>
    </div>

    <nav class="flex items-center space-x-1 sm:space-x-4 text-sm font-medium">
      <a href={`${baseUrl}/`} class="px-3 py-1.5 rounded-md text-slate-300 hover:text-slate-100 hover:bg-slate-850 transition-colors">
        Home
      </a>
      <a href={`${baseUrl}/toc`} class="px-3 py-1.5 rounded-md text-slate-300 hover:text-slate-100 hover:bg-slate-850 transition-colors">
        Table of Contents
      </a>
      <a href="https://gamefaqs.gamespot.com/ps2/459510-shadow-hearts/faqs/80397" target="_blank" rel="noopener noreferrer" class="hidden md:flex items-center space-x-1 px-3 py-1.5 rounded-md text-slate-400 hover:text-gold-400 transition-colors">
        <span>Original Source</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>
