---
import { getTocData } from '../lib/guideData';
import { Search, BookOpen, Compass, Castle, Scroll, Sparkles, House, ExternalLink } from '@lucide/astro';

interface Props {
  currentId?: string;
  isMobileDrawer?: boolean;
}

const { currentId = '', isMobileDrawer = false } = Astro.props;
const tocData = getTocData();
const categories = tocData.guide.overview.sections;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getCategoryIcon(name: string) {
  const n = name.toLowerCase();
  if (n.includes('introduction')) return BookOpen;
  if (n.includes('asia')) return Compass;
  if (n.includes('europe')) return Castle;
  return Scroll;
}
---

<div class={`flex flex-col h-full w-full min-h-0 ${isMobileDrawer ? '' : 'select-none'}`}>
  <!-- Desktop Top Logo Header -->
  {!isMobileDrawer && (
    <div class="p-4 border-b border-slate-800/80 bg-[#07090e] flex-shrink-0 flex items-center justify-center">
      <a href={`${baseUrl}/`} class="block group w-full" aria-label="Shadow Hearts Guide Home">
        <img
          src={`${baseUrl}/logo.png`}
          alt="Shadow Hearts Strategy Guide"
          class="w-full h-auto max-h-14 object-contain mx-auto transition-transform duration-200 group-hover:scale-105"
        />
      </a>
    </div>
  )}

  <!-- Utility Links Strip (Home / Chapters / Original FAQ) -->
  <div class="px-3 py-2 border-b border-slate-800/70 bg-[#0a0d14]/70 flex items-center justify-between gap-1 text-xs text-slate-300 flex-shrink-0">
    <a
      href={`${baseUrl}/`}
      class={`flex items-center gap-1.5 px-2.5 py-1 rounded transition-colors ${
        currentId === '' || currentId === 'home'
          ? 'bg-gold-500/20 text-gold-300 font-semibold border border-gold-500/40 shadow-sm'
          : 'hover:text-gold-300 hover:bg-slate-850'
      }`}
    >
      <House class="w-3.5 h-3.5 text-gold-400" />
      <span>Home</span>
    </a>
    <a
      href={`${baseUrl}/toc`}
      class={`flex items-center gap-1.5 px-2.5 py-1 rounded transition-colors ${
        currentId === 'toc'
          ? 'bg-gold-500/20 text-gold-300 font-semibold border border-gold-500/40 shadow-sm'
          : 'hover:text-gold-300 hover:bg-slate-850'
      }`}
    >
      <BookOpen class="w-3.5 h-3.5 text-gold-400" />
      <span>Chapters</span>
    </a>
    <a
      href="https://gamefaqs.gamespot.com/ps2/459510-shadow-hearts/faqs/80397"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1 px-2 py-1 rounded text-slate-400 hover:text-gold-400 hover:bg-slate-850 transition-colors"
      title="View original GameFAQs guide"
    >
      <span>FAQ</span>
      <ExternalLink class="w-3 h-3" />
    </a>
  </div>

  <!-- Sidebar Header / Search -->
  <div class="p-3 border-b border-slate-800/80 sticky top-0 bg-[#0a0d14]/95 backdrop-blur z-10 space-y-2 flex-shrink-0">
    <div class="flex items-center justify-between text-sm font-serif font-bold uppercase tracking-wider text-gold-400">
      <span>Chapter Index</span>
      <span class="text-xs font-mono text-slate-400 font-normal">69 Sections</span>
    </div>
    <div class="relative">
      <input
        type="text"
        id={isMobileDrawer ? 'mobile-sidebar-search' : 'sidebar-search'}
        placeholder="Filter chapters..."
        class="w-full pl-7 pr-3 py-1.5 bg-slate-900/90 border border-slate-800 rounded text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-gold-500/80 focus:ring-1 focus:ring-gold-500/50"
      />
      <Search class="w-3.5 h-3.5 text-slate-500 absolute left-2 top-2 pointer-events-none" />
    </div>
  </div>

  <!-- Chapters Scroll Area -->
  <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-5 text-sm text-slate-300 custom-scrollbar overscroll-contain" id={isMobileDrawer ? 'mobile-sidebar-list' : 'sidebar-list'}>
    {categories.map((cat) => {
      const CatIcon = getCategoryIcon(cat.category);
      return (
        <div class="sidebar-category space-y-1.5" data-category={cat.category}>
          <div class="text-xs font-serif font-semibold text-slate-400 uppercase tracking-wider px-2 py-1 flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <CatIcon class="w-3.5 h-3.5 text-gold-400/80 flex-shrink-0" />
              <span>{cat.category}</span>
            </span>
            <span class="text-xs font-mono text-slate-400 font-normal">{cat.entries.length}</span>
          </div>

          <ul class="space-y-0.5 border-l border-slate-800/70 ml-2 pl-2">
            {cat.entries.map((entry) => {
              const isActive = entry.id === currentId;
              const isAvailable = entry.has_structured;
              return (
                <li 
                  class="sidebar-item" 
                  data-title={entry.title.toLowerCase()} 
                  data-code={entry.code.toLowerCase()}
                  data-label={(entry.label || '').toLowerCase()}
                  data-active={isActive ? 'true' : undefined}
                >
                  {isAvailable ? (
                    <a
                      href={`${baseUrl}/guide/${entry.id}`}
                      class={`group flex items-start gap-2 px-2.5 py-1.5 rounded transition-all duration-150 ${
                        isActive
                          ? 'bg-gold-500/15 text-gold-300 font-medium border-l-2 border-gold-400 shadow-sm shadow-gold-500/10'
                          : 'text-slate-300 hover:text-slate-100 hover:bg-slate-850/80'
                      }`}
                    >
                      <span class={`w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0 ${
                        isActive ? 'bg-gold-400 ring-2 ring-gold-400/30' : 'bg-emerald-500/70'
                      }`}></span>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-1">
                          <span class="text-xs font-mono text-slate-400 group-hover:text-slate-300 truncate">
                            {entry.label || entry.code}
                          </span>
                          {entry.is_sidequest && (
                            <span class="inline-flex items-center gap-0.5 text-xs px-1.5 py-0.5 rounded bg-purple-950/60 text-purple-300 border border-purple-800/40 font-mono">
                              <Sparkles class="w-2.5 h-2.5" />
                              <span>SQ</span>
                            </span>
                          )}
                        </div>
                        <div class="truncate text-sm leading-snug text-slate-200 group-hover:text-gold-300">
                          {entry.title}
                        </div>
                      </div>
                    </a>
                  ) : (
                    <div class="flex items-start gap-2 px-2.5 py-1.5 text-slate-400 opacity-60 cursor-default">
                      <span class="w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0 bg-slate-700"></span>
                      <div class="flex-1 min-w-0">
                        <div class="text-xs font-mono text-slate-400 truncate">
                          {entry.label || entry.code}
                        </div>
                        <div class="truncate text-sm leading-snug">
                          {entry.title}
                        </div>
                      </div>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>
</div>

<script>
  function setupSidebarSearch(inputId: string, listId: string) {
    const searchInput = document.getElementById(inputId) as HTMLInputElement | null;
    const list = document.getElementById(listId);
    if (!searchInput || !list) return;

    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      const items = list.querySelectorAll<HTMLElement>('.sidebar-item');
      const categories = list.querySelectorAll<HTMLElement>('.sidebar-category');

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const code = item.getAttribute('data-code') || '';
        const label = item.getAttribute('data-label') || '';
        const match = !q || title.includes(q) || code.includes(q) || label.includes(q);
        item.style.display = match ? '' : 'none';
      });

      categories.forEach((cat) => {
        const visibleItems = cat.querySelectorAll('.sidebar-item:not([style*="display: none"])');
        cat.style.display = visibleItems.length > 0 ? '' : 'none';
      });
    });

    // Auto-scroll active item into view within the sidebar
    const activeItem = list.querySelector('[data-active="true"]');
    if (activeItem) {
      activeItem.scrollIntoView({ block: 'nearest' });
    }
  }

  setupSidebarSearch('sidebar-search', 'sidebar-list');
  setupSidebarSearch('mobile-sidebar-search', 'mobile-sidebar-list');
</script>
