---
import { getTocData } from '../lib/guideData';
import type { TocEntry } from '../lib/types';
import SidebarEntry from './SidebarEntry.astro';
import {
  BookOpen, Compass, Castle, Scroll, ChevronRight, TrainFront, Trees, House, Landmark, Anchor, Ship,
  Church, Hospital, Mountain, Swords, Sword, Shield, Shirt, Gem, Store, Coins, Ticket, Skull, Users,
  Footprints, Sparkles, Gift, Syringe, Pickaxe, Ghost, Flag, RotateCcw, Cog, Hammer, Map as MapIcon,
  Trophy, FileText, Copyright, ScrollText, Ribbon, Package, Receipt, Dices, HandCoins, Flame, Heart,
  TowerControl, Bug, Tent, DoorOpen, Info, Scale
} from '@lucide/astro';

interface Props {
  currentId?: string;
  isMobileDrawer?: boolean;
}

const { currentId = '', isMobileDrawer = false } = Astro.props;
const tocData = getTocData();
const categories = tocData.guide.overview.sections;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getCategoryIcon(name: string) {
  const n = name.toLowerCase();
  if (n.includes('introduction')) return BookOpen;
  if (n.includes('asia')) return Compass;
  if (n.includes('europe')) return Castle;
  return Scroll;
}

// Keyword map: first match on "<code> <title>" wins; falls back to a generic icon.
const ENTRY_ICON_RULES: Array<[RegExp, any]> = [
  [/i-1-00|table of contents|directory/, MapIcon],
  [/i-1-01|manual|instructions/, BookOpen],
  [/overview/, Compass],
  [/trans-siberian|express/, TrainFront],
  [/plains/, Trees],
  [/village/, House],
  [/fengtian|prague|london|bistritz/, Landmark],
  [/dalian/, Anchor],
  [/boat/, Ship],
  [/shanghai|kuihai|tower/, TowerControl],
  [/temple|ruins|monastery|nemeton/, Church],
  [/hospital|calios/, Hospital],
  [/orphanage/, Heart],
  [/castle/, Castle],
  [/rouen/, Landmark],
  [/cave/, Mountain],
  [/kowloon|fortress/, Castle],
  [/pit fight/, Swords],
  [/gravestone/, Skull],
  [/fusion|attacks/, Flame],
  [/good ending|ending/, Sparkles],
  [/final preparations/, Flag],
  [/neameeto/, DoorOpen],
  [/new game\+/, RotateCcw],
  [/side quests/, Scroll],
  [/special skills|souls/, Sparkles],
  [/weapons/, Sword],
  [/armor/, Shield],
  [/accessories/, Shirt],
  [/valuables/, Gem],
  [/items/, Package],
  [/store|shop/, Store],
  [/acupuncturist/, Syringe],
  [/lottery/, Ticket],
  [/malice/, Ghost],
  [/pedometer/, Footprints],
  [/npc/, Users],
  [/monster|bestiary/, Bug],
  [/boss/, Skull],
  [/help/, Info],
  [/version history/, ScrollText],
  [/thanks/, Heart],
  [/copyright|disclaimer|credits/, Copyright],
];

function getEntryIcon(code: string, title: string, categoryIcon: any) {
  const hay = `${code} ${title}`.toLowerCase();
  for (const [re, icon] of ENTRY_ICON_RULES) {
    if (re.test(hay)) return icon;
  }
  return categoryIcon;
}

// Nest each run of side-quest entries under the non-side-quest entry that precedes it.
// A side quest with no preceding parent stays top-level (and keeps its badge).
function groupEntries(entries: TocEntry[]): Array<{ entry: TocEntry; children: TocEntry[] }> {
  const groups: Array<{ entry: TocEntry; children: TocEntry[] }> = [];
  for (const entry of entries) {
    const parent = groups[groups.length - 1];
    if (entry.is_sidequest && parent && !parent.entry.is_sidequest) {
      parent.children.push(entry);
    } else {
      groups.push({ entry, children: [] });
    }
  }
  return groups;
}

function getCategoryFullTitle(name: string): string {
  const n = name.toLowerCase();
  if (n.includes('asia')) return 'Walkthrough - Shadow Hearts (Asia)';
  if (n.includes('europe')) return 'Walkthrough - Shadow Hearts (Europe)';
  return name;
}
---

<div class={`flex flex-col h-full w-full min-h-0 ${isMobileDrawer ? '' : 'select-none'}`}>
  <!-- Desktop Top Logo Header -->
  {!isMobileDrawer && (
    <div class="p-4 border-b border-slate-800/80 bg-[#07090e] flex-shrink-0 flex items-center justify-center">
      <a href={`${baseUrl}/`} class="block group w-full" aria-label="Shadow Hearts Guide Home">
        <img
          src={`${baseUrl}/logo.png`}
          alt="Shadow Hearts Strategy Guide"
          class="w-full h-auto max-h-12 object-contain mx-auto transition-transform duration-200 group-hover:scale-105"
        />
      </a>
    </div>
  )}

  <!-- Chapters Scroll Area -->
  <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3 text-sm text-slate-300 custom-scrollbar overscroll-contain" id={isMobileDrawer ? 'mobile-sidebar-list' : 'sidebar-list'}>
    {categories.map((cat, idx) => {
      const CatIcon = getCategoryIcon(cat.category);
      const hasActiveEntry = cat.entries.some((entry) => entry.id === currentId);
      // Auto-expand category if it contains the active entry, or expand the first category on home/toc pages
      const isOpenByDefault = hasActiveEntry || (!currentId && idx === 0);

      return (
        <details
          class="sidebar-category group rounded-lg transition-colors"
          open={isOpenByDefault}
          data-category-id={cat.category}
        >
          <summary
            class="list-none flex items-center justify-between cursor-pointer px-2 py-1.5 rounded-lg text-slate-300 hover:text-gold-300 hover:bg-slate-800/50 transition-colors focus:outline-none"
            title={getCategoryFullTitle(cat.category)}
          >
            <div class="flex items-center gap-2 min-w-0">
              <CatIcon class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" />
              <span class="text-xs font-serif font-medium uppercase tracking-wider text-slate-200 group-hover:text-gold-300 truncate">
                {cat.category}
              </span>
            </div>
            <ChevronRight class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-open:rotate-90 flex-shrink-0" />
          </summary>

          <ul class="mt-1 space-y-0.5 pl-2.5 border-l border-slate-800/80 ml-3 py-1">
            {groupEntries(cat.entries).map((group) => {
              const entry = group.entry;
              const isActive = entry.id === currentId;
              const EntryIcon = entry.is_sidequest
                ? Scroll
                : getEntryIcon(entry.code, entry.title, CatIcon);
              return (
                <li
                  class="sidebar-item"
                  data-active={isActive ? 'true' : undefined}
                >
                  <SidebarEntry
                    href={`${baseUrl}/guide/${entry.id}`}
                    title={entry.title}
                    icon={EntryIcon}
                    isActive={isActive}
                    isAvailable={!!entry.has_structured}
                    showBadge={entry.is_sidequest}
                  />
                  {group.children.length > 0 && (
                    <ul class="sidebar-children mt-0.5 mb-1 ml-4 pl-2 space-y-0.5 border-l border-slate-800/80">
                      {group.children.map((child) => {
                        const childActive = child.id === currentId;
                        return (
                          <li
                            class="sidebar-item"
                            data-active={childActive ? 'true' : undefined}
                          >
                            <SidebarEntry
                              href={`${baseUrl}/guide/${child.id}`}
                              title={child.title}
                              icon={Scroll}
                              isActive={childActive}
                              isAvailable={!!child.has_structured}
                              isChild
                            />
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </div>
</div>

<script>
  function autoScrollActiveItem(listId: string) {
    const list = document.getElementById(listId);
    if (!list) return;
    const activeItem = list.querySelector('[data-active="true"]');
    if (activeItem) {
      activeItem.scrollIntoView({ block: 'nearest' });
    }
  }

  function initAccordionState(listId: string) {
    const list = document.getElementById(listId);
    if (!list) return;
    const detailsElements = list.querySelectorAll<HTMLDetailsElement>('details.sidebar-category');

    detailsElements.forEach((details) => {
      const catId = details.getAttribute('data-category-id');
      const hasActive = details.querySelector('[data-active="true"]');
      if (hasActive) {
        details.open = true;
      } else if (catId) {
        const stored = sessionStorage.getItem(`sidebar-cat-${catId}`);
        if (stored !== null) {
          details.open = stored === 'true';
        }
      }

      details.addEventListener('toggle', () => {
        if (catId) {
          sessionStorage.setItem(`sidebar-cat-${catId}`, String(details.open));
        }
      });
    });
  }

  initAccordionState('sidebar-list');
  initAccordionState('mobile-sidebar-list');
  autoScrollActiveItem('sidebar-list');
  autoScrollActiveItem('mobile-sidebar-list');
</script>
