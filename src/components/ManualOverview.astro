---
import { Compass, ScrollText, Gamepad2, SlidersHorizontal, Swords, MapPin, Sparkles, Clock, Target } from '@lucide/astro';
import CollapsibleSection from './CollapsibleSection.astro';
import BadgeCard from './BadgeCard.astro';
import { renderInlineMarkup } from '../lib/markup';
import { getSystemMeta, getAttributeMeta, getActionMeta } from '../lib/manualMeta';
import type { ManualOverviewData } from '../lib/types';

interface Props {
  overview: ManualOverviewData;
}

const { overview } = Astro.props;

// Prologue badges are icon-only: the source text already carries its own place/time label.
const prologueEntries = [
  { text: overview.story_prologue?.setting_1, icon: MapPin, badgeClass: 'bg-amber-950/50 text-amber-300 border-amber-800/50' },
  { text: overview.story_prologue?.setting_2, icon: Clock, badgeClass: 'bg-sky-950/50 text-sky-300 border-sky-800/50' },
  { text: overview.story_prologue?.inciting_incident, icon: Sparkles, badgeClass: 'bg-rose-950/50 text-rose-300 border-rose-800/50' }
].filter((e) => e.text);

const keyedSections = [
  { entries: overview.playing_the_game, id: 'system', title: 'System & Operations', icon: SlidersHorizontal, getMeta: getSystemMeta },
  { entries: overview.player_attributes, id: 'attributes', title: 'Player Attributes & Battle System', icon: Swords, getMeta: getAttributeMeta }
];

const { directions, controls, battle_mechanics: battle } = overview;
---

<div class="space-y-8">
  {directions && (
    <CollapsibleSection id="compass" title="Compass & Orientation" icon={Compass} flourish={false} class="p-5 rounded-xl bg-slate-850/90 border border-slate-800 space-y-4 shadow-sm">
      {directions.compass_note && (
        <p class="text-slate-300 text-base leading-relaxed">
          <Fragment set:html={renderInlineMarkup(directions.compass_note)} />
        </p>
      )}
      {directions.mappings && directions.mappings.length > 0 && (
        <div class="overflow-x-auto rounded-lg border border-slate-800">
          <table class="w-full text-sm text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-700/80 text-slate-400 font-mono bg-slate-900/60">
                <th scope="col" class="py-2.5 px-3">Screen Direction</th>
                <th scope="col" class="py-2.5 px-3">Cardinal Direction</th>
                <th scope="col" class="py-2.5 px-3">Abbreviation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-300">
              {directions.mappings.map((m) => (
                <tr class="hover:bg-slate-800/40">
                  <td class="py-2 px-3 font-medium">{m.screen}</td>
                  <td class="py-2 px-3 text-gold-400 font-semibold">{m.cardinal}</td>
                  <td class="py-2 px-3 font-mono text-slate-400">{m.abbr}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </CollapsibleSection>
  )}

  {overview.intro && (
    <div class="p-4 rounded-xl bg-slate-850/90 border border-slate-800 text-slate-300 text-base italic leading-relaxed">
      <Fragment set:html={renderInlineMarkup(overview.intro)} />
    </div>
  )}

  {prologueEntries.length > 0 && (
    <CollapsibleSection id="prologue" title="Story Prologue" icon={ScrollText}>
      <div class="grid gap-3">
        {prologueEntries.map((e) => (
          <BadgeCard icon={e.icon} badgeClass={e.badgeClass}>
            <p><Fragment set:html={renderInlineMarkup(e.text!)} /></p>
          </BadgeCard>
        ))}
      </div>
    </CollapsibleSection>
  )}

  {controls && (
    <CollapsibleSection id="controls" title="Controls & Controller Layout" icon={Gamepad2}>
      {controls.controller_layout && (
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-850/90">
          <table class="w-full text-sm sm:text-base text-left">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400 font-mono bg-slate-900/60">
                <th scope="col" class="py-2.5 px-3">Button / Input</th>
                <th scope="col" class="py-2.5 px-3">Function</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-slate-300">
              {controls.controller_layout.map((c) => (
                <tr class="hover:bg-slate-800/40">
                  <td class="py-2.5 px-3 font-mono text-gold-400 font-semibold whitespace-nowrap">
                    <Fragment set:html={renderInlineMarkup(c.button)} />
                  </td>
                  <td class="py-2.5 px-3">
                    <Fragment set:html={renderInlineMarkup(c.function)} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {controls.menu_navigation && (
        <p class="text-sm text-slate-300 italic mt-2 leading-relaxed">
          <Fragment set:html={renderInlineMarkup(controls.menu_navigation)} />
        </p>
      )}
    </CollapsibleSection>
  )}

  {keyedSections.filter((s) => s.entries).map((s) => (
    <CollapsibleSection id={s.id} title={s.title} icon={s.icon}>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {Object.entries(s.entries!).map(([key, val]) => {
          const meta = s.getMeta(key);
          return (
            <BadgeCard icon={meta.icon} label={meta.label} badgeClass={meta.badgeClass}>
              <Fragment set:html={renderInlineMarkup(val)} />
            </BadgeCard>
          );
        })}
      </div>
    </CollapsibleSection>
  ))}

  {battle && (
    <CollapsibleSection id="battle-mechanics" title="Battle Mechanics" icon={Swords}>
      {battle.encounter_flow && (
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          <Fragment set:html={renderInlineMarkup(battle.encounter_flow)} />
        </p>
      )}
      {battle.action_menu && (
        <div class="space-y-2.5">
          <h3 class="text-base sm:text-lg font-serif font-bold text-slate-200">Battle Actions</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {battle.action_menu.map((a) => {
              const meta = getActionMeta(a.action);
              return (
                <BadgeCard icon={meta.icon} label={a.action} badgeClass={meta.badgeClass} labelClass="text-xs font-mono font-bold uppercase tracking-wider">
                  <Fragment set:html={renderInlineMarkup(a.description)} />
                </BadgeCard>
              );
            })}
          </div>
        </div>
      )}
      {battle.judgment_ring && (
        <div class="p-5 rounded-xl bg-amber-950/20 border border-amber-800/50 text-sm sm:text-base space-y-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-900/60 text-amber-200 border border-amber-700/60">
              <Target class="w-3.5 h-3.5 text-amber-300" aria-hidden="true" />
              <span>Core Combat Mechanic</span>
            </span>
          </div>
          <h3 class="font-serif font-bold text-amber-300 text-lg sm:text-xl">Judgment Ring System</h3>
          <p class="text-slate-200 text-base leading-relaxed">
            <Fragment set:html={renderInlineMarkup(battle.judgment_ring.description)} />
          </p>
          <p class="text-slate-300 text-base leading-relaxed">
            <Fragment set:html={renderInlineMarkup(battle.judgment_ring.mechanics)} />
          </p>
          {battle.judgment_ring.character_variation && (
            <p class="text-amber-300/90 text-sm italic">
              <Fragment set:html={renderInlineMarkup(battle.judgment_ring.character_variation)} />
            </p>
          )}
        </div>
      )}
      {battle.command_menu && (
        <p class="text-sm sm:text-base text-slate-400 italic">
          <Fragment set:html={renderInlineMarkup(battle.command_menu)} />
        </p>
      )}
    </CollapsibleSection>
  )}
</div>
