---
import { Target } from '@lucide/astro';
import { renderInlineMarkup } from '../lib/markup';
import SectionHeading from './SectionHeading.astro';

interface Props {
  objectives?: string[];
}

const { objectives = [] } = Astro.props;
---

{objectives.length > 0 && (
  <section id="objectives" class="space-y-3">
    <SectionHeading icon={Target}>Primary Objectives</SectionHeading>
    <div class="card p-5">
      <ul class="space-y-2.5 text-slate-200 text-base">
        {objectives.map((obj) => (
          <li class="flex items-start gap-2.5">
            <Target class="w-4 h-4 text-gold-400 mt-1 flex-shrink-0" aria-hidden="true" />
            <span class="leading-relaxed"><Fragment set:html={renderInlineMarkup(obj)} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
