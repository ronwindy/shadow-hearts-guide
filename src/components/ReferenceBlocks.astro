---
import { FileText } from '@lucide/astro';

interface ReferenceBlock {
  title?: string;
  format: string;
  text: string;
}

interface Props {
  blocks?: ReferenceBlock[];
}

const { blocks = [] } = Astro.props;
---

{blocks.length > 0 && (
  <section id="reference" class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-xl sm:text-2xl font-serif font-bold text-slate-100 flex items-center gap-2.5">
        <FileText class="w-5 h-5 text-gold-400 flex-shrink-0" />
        <span>Reference Tables</span>
      </h2>
    </div>
    {blocks.map((b) => (
      <div class="space-y-2">
        {b.title && <h3 class="text-lg font-serif font-bold text-gold-400">{b.title}</h3>}
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-850/90 shadow-sm">
          <pre class="p-4 text-xs sm:text-sm font-mono text-slate-200 whitespace-pre">{b.text}</pre>
        </div>
      </div>
    ))}
  </section>
)}
