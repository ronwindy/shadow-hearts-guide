---
import { toSentences } from '../lib/sentences';
import { renderHighlights } from '../lib/markup';

interface Props {
  /** Verbatim paragraph(s); each is split into one sentence per bullet. */
  texts: string[];
  class?: string;
}

const { texts, class: className = '' } = Astro.props;
const sentences = texts.flatMap(toSentences);
---

<ul class:list={['sentence-list gothic-bullets text-base text-slate-300 leading-relaxed', className]}>
  {sentences.map((s) => <li set:html={renderHighlights(s)} />)}
</ul>

<style>
  .sentence-list > li {
    margin-top: 0.4rem;
  }
  .sentence-list > li:first-child {
    margin-top: 0;
  }
</style>
