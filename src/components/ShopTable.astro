---
import { Store, Package, Coins } from '@lucide/astro';
import type { ShopInfo } from '../lib/types';
import { spaceCamelCase } from '../lib/markup';

interface Props {
  shops: ShopInfo[];
}

const { shops = [] } = Astro.props;
---

{shops && shops.length > 0 && (
  <section id="shops" class="space-y-4">
    <div class="heading-flourish">
      <h2 class="text-xl sm:text-2xl font-serif font-semibold text-slate-100 flex items-center gap-2.5">
        <Store class="w-5 h-5 text-gold-400 flex-shrink-0" />
        <span>Shops & Merchants</span>
      </h2>
    </div>
    {shops.map((s) => (
      <div class="space-y-2.5">
        <h3 class="text-lg sm:text-xl font-serif font-semibold text-gold-400 flex items-center gap-2">
          <Store class="w-4 h-4 text-amber-400 flex-shrink-0" />
          <span>{s.name}</span>
        </h3>
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-850/90 shadow-sm">
          <table class="w-full text-sm sm:text-base text-left">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400 font-mono bg-slate-900/60">
                <th class="py-2.5 px-4">Item</th>
                <th class="py-2.5 px-4">Price</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-slate-300">
              {s.inventory?.map((inv) => (
                <tr class="hover:bg-slate-800/40">
                  <td class="py-2.5 px-4 font-medium text-slate-200">
                    <span class="inline-flex items-center gap-1.5">
                      <Package class="w-3.5 h-3.5 text-slate-300 flex-shrink-0" />
                      <span>{spaceCamelCase(inv.name)}</span>
                    </span>
                  </td>
                  <td class="py-2.5 px-4 font-mono text-gold-400">
                    <span class="inline-flex items-center gap-1" aria-label={`${inv.price} Cash`}>
                      <Coins class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" aria-hidden="true" />
                      <span>{inv.price}</span>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </section>
)}
