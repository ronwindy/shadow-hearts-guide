---
import Navigation from '../components/Navigation.astro';
import SourceAttribution from '../components/SourceAttribution.astro';
import MobileNavDrawer from '../components/MobileNavDrawer.astro';
import SidebarNav from '../components/SidebarNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  pageSections?: Array<{ id: string; label: string; count?: number }>;
  isWide?: boolean;
  showSidebar?: boolean;
}

const {
  title = "Shadow Hearts — Complete Guide & Walkthrough",
  description = "A polished, player-friendly static companion for the PlayStation 2 classic Shadow Hearts, preserving full canonical walkthrough and FAQ depth.",
  currentId = "",
  pageSections = [],
  isWide = true,
  showSidebar = true
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Grenze:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600;1,700;1,800&family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-void text-slate-100 flex flex-col min-h-screen relative selection:bg-gold-500/30 selection:text-gold-300">
    <!-- Fixed Site Background -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-20"
        style={`background-image: url('${baseUrl}/background.jpg');`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-void/60 via-void/30 to-void/80"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(212,175,55,0.06),transparent),radial-gradient(ellipse_60%_40%_at_90%_80%,rgba(190,18,60,0.05),transparent)]"></div>
    </div>

    <Navigation />
    <MobileNavDrawer currentId={currentId} pageSections={pageSections} />
    <div class={`flex-grow w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 ${isWide ? 'max-w-[1600px]' : 'max-w-7xl'}`}>
      <div class="flex gap-6 lg:gap-8 items-start relative">
        {showSidebar && (
          <aside class="hidden lg:flex flex-col w-64 xl:w-72 flex-shrink-0 sticky top-6 h-[calc(100vh-3rem)] rounded-xl border border-slate-800/80 bg-obsidian/80 backdrop-blur shadow-sm overflow-hidden">
            <SidebarNav currentId={currentId} />
          </aside>
        )}
        <main class="flex-1 min-w-0">
          <slot />
        </main>
      </div>
    </div>
    <SourceAttribution />
  </body>
</html>
