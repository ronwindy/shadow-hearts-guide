---
import Navigation from '../components/Navigation.astro';
import MobileNavDrawer from '../components/MobileNavDrawer.astro';
import SidebarNav from '../components/SidebarNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  pageSections?: Array<{ id: string; label: string; count?: number }>;
  isWide?: boolean;
  showSidebar?: boolean;
}

const {
  title = "Shadow Hearts — Complete Guide & Walkthrough",
  description = "A polished, player-friendly static companion for the PlayStation 2 classic Shadow Hearts, preserving full canonical walkthrough and FAQ depth.",
  currentId = "",
  pageSections = [],
  isWide = true,
  showSidebar = true
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Jost:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Apply saved sidebar state before first paint (no flash). Default: collapsed below 1280px.
      (function () {
        var state = null;
        try { state = localStorage.getItem('sidebar-state'); } catch (e) {}
        if (state !== 'open' && state !== 'collapsed') {
          state = window.innerWidth < 1280 ? 'collapsed' : 'open';
        }
        document.documentElement.setAttribute('data-sidebar', state);
      })();
    </script>
    <style is:global>
      .sidebar-aside {
        transition: width 0.25s ease;
      }
      html[data-sidebar='collapsed'] .sidebar-aside {
        width: 0;
        border-right-width: 0;
      }
      .sidebar-toggle {
        position: absolute;
        top: 50%;
        left: 100%;
        transform: translateY(-50%);
        width: 20px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        background: rgba(7, 9, 14, 0.92);
        border: 1px solid rgba(51, 65, 85, 0.8);
        border-left: 0;
        border-radius: 0 8px 8px 0;
        cursor: pointer;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .sidebar-toggle:hover,
      .sidebar-toggle:focus-visible {
        color: #fbbf24;
        background: rgba(15, 20, 30, 0.98);
      }
      .sidebar-toggle svg {
        transition: transform 0.25s ease;
      }
      html[data-sidebar='collapsed'] .sidebar-toggle svg {
        transform: rotate(180deg);
      }
      @media (prefers-reduced-motion: reduce) {
        .sidebar-aside,
        .sidebar-toggle svg {
          transition: none;
        }
      }
    </style>
  </head>
  <body class="bg-void text-slate-100 flex flex-col min-h-screen relative selection:bg-gold-500/30 selection:text-gold-300">
    <!-- Fixed Site Background -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-20"
        style={`background-image: url('${baseUrl}/background.jpg');`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-void/60 via-void/30 to-void/80"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(212,175,55,0.06),transparent),radial-gradient(ellipse_60%_40%_at_90%_80%,rgba(190,18,60,0.05),transparent)]"></div>
    </div>

    <!-- Shared gold-metal text filters (see .gold-metal-text / .gold-metal-lite in global.css).
         Must not be display:none or the filters break in some browsers. -->
    <svg aria-hidden="true" width="0" height="0" style="position:absolute" focusable="false">
      <defs>
        <filter id="gold-metal" x="-5%" y="-25%" width="110%" height="150%" color-interpolation-filters="sRGB">
          <!-- hairline dark-gold edge for definition -->
          <feMorphology in="SourceAlpha" operator="dilate" radius="0.7" result="grow-in" />
          <feFlood flood-color="#4a2f06" />
          <feComposite in2="grow-in" operator="in" result="rim-in" />

          <!-- cloudy, smoky mottling over the face -->
          <feTurbulence type="fractalNoise" baseFrequency="0.03 0.08" numOctaves="3" seed="11" result="noise" />
          <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.42  0 0 0 0 0.27  0 0 0 0 0.04  0 0 0 1.7 -0.62" result="mottle" />
          <feComposite in="mottle" in2="SourceAlpha" operator="in" result="mottle-in" />

          <!-- raised bevel: highlights and shade from a blurred height map -->
          <feGaussianBlur in="SourceAlpha" stdDeviation="1.1" result="height" />
          <feSpecularLighting in="height" surfaceScale="3.5" specularConstant="1.2" specularExponent="22" lighting-color="#fff7d2" result="spec">
            <feDistantLight azimuth="235" elevation="46" />
          </feSpecularLighting>
          <feComposite in="spec" in2="SourceAlpha" operator="in" result="spec-in" />

          <feMerge>
            <feMergeNode in="rim-in" />
            <feMergeNode in="SourceGraphic" />
            <feMergeNode in="mottle-in" />
            <feMergeNode in="spec-in" />
          </feMerge>
        </filter>

        <!-- lighter variant for h2 headings: hairline edge and a soft bevel, no turbulence -->
        <filter id="gold-metal-lite" x="-5%" y="-30%" width="110%" height="160%" color-interpolation-filters="sRGB">
          <feMorphology in="SourceAlpha" operator="dilate" radius="0.5" result="grow-in" />
          <feFlood flood-color="#4a2f06" />
          <feComposite in2="grow-in" operator="in" result="rim-in" />

          <feGaussianBlur in="SourceAlpha" stdDeviation="0.8" result="height" />
          <feSpecularLighting in="height" surfaceScale="2" specularConstant="0.9" specularExponent="20" lighting-color="#fff7d2" result="spec">
            <feDistantLight azimuth="235" elevation="50" />
          </feSpecularLighting>
          <feComposite in="spec" in2="SourceAlpha" operator="in" result="spec-in" />

          <feMerge>
            <feMergeNode in="rim-in" />
            <feMergeNode in="SourceGraphic" />
            <feMergeNode in="spec-in" />
          </feMerge>
        </filter>
      </defs>
    </svg>

    <Navigation />
    <MobileNavDrawer currentId={currentId} pageSections={pageSections} />

    <div class="flex-grow flex min-h-screen w-full relative">
      {showSidebar && (
        <div class="sidebar-shell hidden lg:block flex-shrink-0 sticky top-0 h-screen z-30">
          <aside id="desktop-sidebar" class="sidebar-aside h-full lg:w-72 xl:w-80 border-r border-slate-800/80 bg-[#07090e]/95 backdrop-blur overflow-hidden">
            <div class="flex flex-col h-full w-72 xl:w-80">
              <SidebarNav currentId={currentId} />
            </div>
          </aside>
          <button
            type="button"
            id="sidebar-toggle"
            class="sidebar-toggle"
            aria-controls="desktop-sidebar"
            aria-expanded="true"
            aria-label="Hide chapter sidebar"
            title="Hide/show sidebar"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12.5 4.5 7 10l5.5 5.5" />
            </svg>
          </button>
        </div>
      )}
      <div class="flex-1 min-w-0 flex flex-col justify-between">
        <main class={`flex-grow w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 ${isWide ? 'max-w-[1440px]' : 'max-w-5xl'}`}>
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('sidebar-toggle');
        var aside = document.getElementById('desktop-sidebar');
        if (!btn || !aside) return;
        var root = document.documentElement;
        function sync() {
          var collapsed = root.getAttribute('data-sidebar') === 'collapsed';
          btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          btn.setAttribute('aria-label', collapsed ? 'Show chapter sidebar' : 'Hide chapter sidebar');
          if (collapsed) aside.setAttribute('inert', ''); else aside.removeAttribute('inert');
        }
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-sidebar') === 'collapsed' ? 'open' : 'collapsed';
          root.setAttribute('data-sidebar', next);
          try { localStorage.setItem('sidebar-state', next); } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>

