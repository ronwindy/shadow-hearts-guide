{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-hearts-guide/schemas/structured-guide.schema.json",
  "title": "StructuredGuide",
  "description": "Schema definition for player-friendly structured game guide content converted from canonical source sections.",
  "type": "object",
  "required": ["guide"],
  "$defs": {
    "character_profile": {
      "type": "object",
      "required": ["name", "profile"],
      "properties": {
        "name": { "type": "string" },
        "age": { "type": ["string", "null"] },
        "class": { "type": ["string", "null"] },
        "profile": { "type": "string" }
      },
      "additionalProperties": false
    },
    "glossary_entry": {
      "type": "object",
      "required": ["term", "description"],
      "properties": {
        "term": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "controller_mapping": {
      "type": "object",
      "required": ["button", "function"],
      "properties": {
        "button": { "type": "string" },
        "function": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "guide": {
      "type": "object",
      "required": [
        "id",
        "code",
        "title",
        "type",
        "category",
        "source",
        "navigation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique slug identifier for the guide section (e.g. w-1-01)"
        },
        "code": {
          "type": "string",
          "description": "Original bracketed section code (e.g. [W-1-01])"
        },
        "title": {
          "type": "string",
          "description": "Title of the guide section"
        },
        "type": {
          "type": "string",
          "enum": [
            "walkthrough",
            "walkthrough_intro",
            "sidequest",
            "mechanics",
            "reference"
          ],
          "description": "Logical guide classification"
        },
        "category": {
          "type": "string",
          "description": "Parent category (e.g. Walkthrough - Asia)"
        },
        "source": {
          "type": "object",
          "required": ["game", "author", "version"],
          "properties": {
            "game": { "type": "string" },
            "author": { "type": "string" },
            "version": { "type": "string" },
            "url": { "type": "string" },
            "source_url": { "type": "string" },
            "source_file": { "type": "string" }
          },
          "additionalProperties": true
        },
        "navigation": {
          "type": "object",
          "properties": {
            "prev": {
              "type": ["object", "null"],
              "required": ["id", "code", "title", "file"],
              "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "title": { "type": "string" },
                "file": { "type": "string" }
              }
            },
            "next": {
              "type": ["object", "null"],
              "required": ["id", "code", "title", "file"],
              "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "title": { "type": "string" },
                "file": { "type": "string" }
              }
            }
          },
          "additionalProperties": false
        },
        "initial_setup": {
          "type": "object",
          "properties": {
            "character": { "type": "string" },
            "equipment": {
              "type": "array",
              "items": { "type": "string" }
            },
            "valuables": {
              "type": "array",
              "items": { "type": "string" }
            },
            "souls": {
              "type": "array",
              "items": { "type": "string" }
            },
            "note": { "type": "string" }
          },
          "additionalProperties": true
        },
        "overview": {
          "type": "object",
          "description": "General overview data for introductory, reference, or mechanics sections",
          "properties": {
            "characters": {
              "type": "array",
              "items": { "$ref": "#/$defs/character_profile" }
            },
            "glossary": {
              "type": "array",
              "items": { "$ref": "#/$defs/glossary_entry" }
            },
            "controls": {
              "type": "object",
              "properties": {
                "controller_layout": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/controller_mapping" }
                },
                "menu_navigation": { "type": "string" }
              }
            }
          },
          "additionalProperties": true
        },
        "route": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered progression route of locations or areas"
        },
        "objectives": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Key player goals for this section"
        },
        "items_summary": {
          "type": "object",
          "properties": {
            "obtainable": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "category"],
                "properties": {
                  "name": { "type": "string" },
                  "category": { "type": "string" },
                  "location": { "type": "string" },
                  "missable": { "type": "boolean" },
                  "condition": { "type": "string" }
                }
              }
            },
            "initial": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "category"],
                "properties": {
                  "name": { "type": "string" },
                  "category": { "type": "string" }
                }
              }
            }
          },
          "additionalProperties": true
        },
        "enemies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "number": { "type": ["string", "null"] },
              "name": { "type": "string" },
              "hp": { "type": ["integer", "string", "null"] },
              "class": { "type": ["string", "null"] },
              "is_boss": { "type": "boolean" },
              "is_subboss": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        },
        "bosses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "enemies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "hp": { "type": ["integer", "null"] },
                    "class": { "type": ["string", "null"] },
                    "drop": { "type": "string" }
                  }
                }
              },
              "party": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "level"],
                  "properties": {
                    "name": { "type": "string" },
                    "level": { "type": "integer" }
                  }
                }
              },
              "exp": { "type": ["integer", "null"] },
              "cash": { "type": ["integer", "null"] },
              "strategy": { "type": "string" }
            }
          }
        },
        "boss": {
          "type": ["object", "null"],
          "description": "Single boss alias matching canonical structure"
        },
        "shops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "inventory"],
            "properties": {
              "name": { "type": "string" },
              "inventory": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "price"],
                  "properties": {
                    "name": { "type": "string" },
                    "price": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "type"],
            "properties": {
              "id": { "type": "integer" },
              "description": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "story",
                  "exploration",
                  "battle",
                  "boss",
                  "loot",
                  "puzzle",
                  "shop",
                  "dialogue",
                  "navigation",
                  "quest",
                  "preparation",
                  "misc"
                ]
              },
              "encounter": {
                "type": "object",
                "properties": {
                  "enemies": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        { "type": "string" },
                        { "type": "object" }
                      ]
                    }
                  }
                }
              },
              "rewards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "category"],
                  "properties": {
                    "name": { "type": "string" },
                    "category": { "type": "string" },
                    "matched_overview_item": { "type": "string" },
                    "quantity": { "type": ["integer", "string"] },
                    "condition": { "type": "string" }
                  }
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "title", "text"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "tutorial",
                        "warning",
                        "tip",
                        "missable",
                        "lore",
                        "strategy",
                        "discrepancy"
                      ]
                    },
                    "title": { "type": "string" },
                    "text": { "type": "string" }
                  }
                }
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["option", "outcome"],
                  "properties": {
                    "option": { "type": "string" },
                    "outcome": { "type": "string" },
                    "reward": { "type": "string" }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "title", "text"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "tutorial",
                  "warning",
                  "tip",
                  "missable",
                  "lore",
                  "strategy",
                  "discrepancy"
                ]
              },
              "title": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
